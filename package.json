{
  "name": "envision-portal",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build-start": "pnpm build && pnpm preview",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint:js": "eslint .",
    "lint:prettier": "prettier --check .",
    "lint": "pnpm lint:js && pnpm lint:prettier",
    "lint:fix": "prettier --write --list-different . && pnpm lint:js --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev --preview-feature",
    "prisma:studio": "prisma studio",
    "prisma:db:push": "prisma db push",
    "prisma:db:pull": "prisma db pull",
    "postinstall": "nuxt prepare && prisma generate",
    "reset": "rm -rf node_modules .nuxt .output dist && pnpm install",
    "prune-branches": "npx git-removed-branches --prune --force",
    "scripts:edit:record": "tsx ./scripts/edit-record.ts",
    "scripts:create:record": "tsx ./scripts/create-record.ts",
    "scripts:process:task-queue": "tsx ./scripts/process-task-queue.ts"
  },
